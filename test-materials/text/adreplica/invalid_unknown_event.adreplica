<advideo version="1" kind="replica-blueprint" aspect="9:16" duration="12">
  <meta source="反例样例" format="handwritten-sample">
    <goal>反例：未知事件类型 stinger（events 内元素名即事件类型，词汇表外应 422）</goal>
    <reading>事件类型词汇表为 broll/caption/sfx/mg/transition，stinger 不在其中。</reading>
  </meta>
  <cast>
    <slot kind="character" label="人物" source="原片主播" replace-with="" />
  </cast>
  <script>
    <beat id="vb1" role="hook" dur="0-6">缺陷隔离样例段落一</beat>
    <beat id="vb2" role="cta" dur="6-12">缺陷隔离样例段落二</beat>
  </script>
  <timeline>
    <shot id="vs1" size="medium" motion="static" start="0" dur="6" cut="cut" text="" recreate="" during="vb1">占位镜头一</shot>
    <shot id="vs2" size="medium" motion="static" start="6" dur="6" cut="cut" text="" recreate="" during="vb2">占位镜头二</shot>
  </timeline>
  <events>
    <stinger id="vsting1" during="vb2" trigger="结尾" keep="true">未知事件类型占位</stinger>
  </events>
  <rhythm avg-shot="6" curve="平直" cuts="0,6" />
  <systems captions="" music="">
  </systems>
  <constraints>
    <constraint>预期导入失败并返回结构化错误，不静默降级</constraint>
  </constraints>
</advideo>
