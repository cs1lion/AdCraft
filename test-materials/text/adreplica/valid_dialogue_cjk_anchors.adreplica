<advideo version="1" kind="replica-blueprint" aspect="9:16" duration="20">
  <meta source="rep_dialogue_9x16_20s.mp4" format="dialogue-skit">
    <goal>换台词：把种草对话小剧场改为健身打卡主题，结构保留</goal>
    <reading>五镜双人正反打：钩子-反驳-证明-动摇-合流，平均每镜 4 秒。</reading>
  </meta>
  <cast>
    <slot kind="character" label="人物" source="主播 A 与主播 B" replace-with="sample_host.png" />
    <slot kind="product" label="商品" source="原片商品" replace-with="" />
    <slot kind="script" label="台词" source="种草对话" replace-with="健身打卡对话" />
    <slot kind="style" label="风格" source="生活化小剧场" replace-with="" />
    <slot kind="voice" label="声音" source="双人口播" replace-with="" />
    <slot kind="scene" label="场景" source="室内沙发" replace-with="" />
  </cast>
  <script>
    <beat id="db1" role="hook" dur="0-4"><line>你@{dcap1}敢信@{/dcap1}？</line></beat>
    <beat id="db2" role="conflict" dur="4-8"><line>我@{dcap2}不信@{/dcap2}。</line></beat>
    <beat id="db3" role="proof" dur="8-12"><line>它真的有用！</line></beat>
    <beat id="db4" role="turn" dur="12-16"><line>那我试试！</line></beat>
    <beat id="db5" role="cta" dur="16-20"><line>冲！！</line></beat>
  </script>
  <timeline>
    <shot id="ds1" size="medium" motion="static" start="0" dur="4" cut="cut" text="A：你敢信？" recreate="同机位换人物" during="db1">A 正面持机</shot>
    <shot id="ds2" size="medium" motion="static" start="4" dur="4" cut="cut" text="B：我不信。" recreate="同机位换人物" during="db2">B 正面持机</shot>
    <shot id="ds3" size="closeup" motion="zoom-in" start="8" dur="4" cut="cut" text="A：它真的有用！" recreate="" during="db3">A 强调特写</shot>
    <shot id="ds4" size="medium" motion="static" start="12" dur="4" cut="cut" text="B：那我试试！" recreate="" during="db4">B 动摇</shot>
    <shot id="ds5" size="wide" motion="static" start="16" dur="4" cut="cut" text="合：冲！！" recreate="" during="db5">双人同框</shot>
  </timeline>
  <events>
    <caption id="dcap1" during="db1" trigger="敢信" keep="true">钩子大字</caption>
    <caption id="dcap2" during="db2" trigger="不信" keep="true">反驳字幕</caption>
    <sfx id="ds_whoosh" during="db3" trigger="证明反转" keep="false">出场 whoosh</sfx>
    <broll id="dbroll1" during="db5" trigger="结尾" keep="true">运动空镜两秒</broll>
  </events>
  <rhythm avg-shot="4" curve="前稳后扬" cuts="0,4,8,12,16" />
  <systems captions="底部大字白底黑边" music="轻快电子">
    <graphics>进度贴：第三镜起挂打卡日历</graphics>
  </systems>
  <constraints>
    <constraint>手写正例样例：验证 CJK 行内词锚的导入解析（词锚绑定 dcap1/dcap2 两个字幕事件）</constraint>
  </constraints>
</advideo>
