<advideo version="2" kind="replica-blueprint" aspect="9:16" duration="12">
  <meta source="反例样例" format="handwritten-sample">
    <goal>反例：语法版本 version="2" 不受支持（当前仅 version="1"），导入应 422（unsupported version）</goal>
    <reading>除版本号外均为合法结构，用于隔离单一缺陷。</reading>
  </meta>
  <cast>
    <slot kind="character" label="人物" source="原片主播" replace-with="" />
  </cast>
  <script>
    <beat id="ob1" role="hook" dur="0-6">缺陷隔离样例段落一</beat>
    <beat id="ob2" role="cta" dur="6-12">缺陷隔离样例段落二</beat>
  </script>
  <timeline>
    <shot id="os1" size="medium" motion="static" start="0" dur="6" cut="cut" text="" recreate="" during="ob1">占位镜头一</shot>
    <shot id="os2" size="medium" motion="static" start="6" dur="6" cut="cut" text="" recreate="" during="ob2">占位镜头二</shot>
  </timeline>
  <events>
  </events>
  <rhythm avg-shot="6" curve="平直" cuts="0,6" />
  <systems captions="" music="">
  </systems>
  <constraints>
    <constraint>预期导入失败并返回结构化错误，不静默降级</constraint>
  </constraints>
</advideo>
