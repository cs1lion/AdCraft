<advideo version="1" kind="replica-blueprint" aspect="9:16" duration="12">
  <meta source="反例样例" format="handwritten-sample">
    <goal>反例：幽灵词锚——行内锚引用未声明的事件 gcap1，导入应 422（inline anchor references unknown event）</goal>
    <reading>词锚 id 在 events 中不存在，用于隔离单一缺陷。</reading>
  </meta>
  <cast>
    <slot kind="character" label="人物" source="原片主播" replace-with="" />
  </cast>
  <script>
    <beat id="gb1" role="hook" dur="0-6"><line>你@{gcap1}敢信@{/gcap1}？</line></beat>
    <beat id="gb2" role="cta" dur="6-12"><line>冲！</line></beat>
  </script>
  <timeline>
    <shot id="gs1" size="medium" motion="static" start="0" dur="6" cut="cut" text="" recreate="" during="gb1">占位镜头一</shot>
    <shot id="gs2" size="medium" motion="static" start="6" dur="6" cut="cut" text="" recreate="" during="gb2">占位镜头二</shot>
  </timeline>
  <events>
    <caption id="rcap1" during="gb2" trigger="无关事件" keep="true">这里声明的是 rcap1，不是 gcap1</caption>
  </events>
  <rhythm avg-shot="6" curve="平直" cuts="0,6" />
  <systems captions="" music="">
  </systems>
  <constraints>
    <constraint>预期导入失败并返回结构化错误，不静默降级</constraint>
  </constraints>
</advideo>
