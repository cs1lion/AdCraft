APP_NAME=AdCraft
APP_VERSION=1.0.0
AGENT_RUNTIME_MODE=real
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8765
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8765
AGENT_RUNTIME_PYTHON_BASE_URL=http://127.0.0.1:8000
AGENT_RUNTIME_INTERNAL_TOKEN=
AGENT_RUNTIME_PROTOCOL_VERSION=1
AGENT_RUNTIME_CONNECT_TIMEOUT_SECONDS=5
AGENT_RUNTIME_READ_TIMEOUT_SECONDS=30
AGENT_RUNTIME_RUN_TIMEOUT_SECONDS=120
AGENT_RUNTIME_MAX_EVENT_BYTES=65536
AGENT_RUNTIME_MAX_STREAM_BYTES=1048576
V2_PRODUCTION_ACCEPTANCE_ENABLED=false
SKIP_AUDIO_AGENTS=true
LLM_PROVIDER=OpenAI Compatible
LLM_API_KEY=
LLM_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_TRANSIENT_RETRY_DELAY_SECONDS=2
# 拉片拆解单次 LLM 读超时（秒）：step 系模型综合调用有 >120s 长尾，默认 300
REPLICA_TEARDOWN_LLM_TIMEOUT_SECONDS=300
# 拉片拆解传输层超时后的重试次数：一次慢调用再给一次机会，默认 1
REPLICA_TEARDOWN_LLM_RETRIES=1
LLM_FRONT_DESK_MODEL=doubao-seed-2-0-mini-260428
LLM_TEAM_MODEL=doubao-seed-2-0-mini-260428
LLM_REQUIREMENTS_MODEL=doubao-seed-2-0-mini-260428
LLM_PRODUCT_DESIGN_MODEL=doubao-seed-2-0-mini-260428
LLM_CREATIVE_MODEL=doubao-seed-2-0-mini-260428
LLM_SCRIPT_MODEL=doubao-seed-2-0-mini-260428
LLM_CHARACTER_MODEL=doubao-seed-2-0-mini-260428
LLM_SCENE_MODEL=doubao-seed-2-0-mini-260428
LLM_STORYBOARD_MODEL=doubao-seed-2-0-mini-260428
LLM_SOUND_EFFECTS_MODEL=doubao-seed-2-0-mini-260428
LLM_VOICEOVER_MODEL=doubao-seed-2-0-mini-260428
LLM_BGM_MODEL=doubao-seed-2-0-mini-260428
LLM_FINAL_VIDEO_MODEL=doubao-seed-2-0-mini-260428
MEDIA_MODE=real
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
IMAGE_GENERATION_MODEL=doubao-seedream-5-0-260128
IMAGE_GENERATION_SIZE=1920x1920
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
VIDEO_GENERATION_MODEL=seedance-1-0-pro-fast-251015
VIDEO_GENERATION_RESOLUTION=720p
VIDEO_GENERATION_GENERATE_AUDIO=true
# Where this deployment's /media/... asset paths are reachable from the internet,
# e.g. https://media.example.com. The asset library records a public_url as a
# PATH, so every asset is refused by the provider's public-URL gate until this
# names the host that serves those paths -- which is what stands between a bound
# previs clip and the provider's videos[] channel. Must be https and a public
# host: a bare IP, http://, or a self-signed cert does not pass the gate.
PROVIDER_REFERENCE_PUBLIC_BASE_URL=
SOUND_EFFECTS_API_KEY=
SOUND_EFFECTS_ENDPOINT=
SOUND_EFFECTS_MODEL=
TTS_API_KEY=
TTS_ENDPOINT=
TTS_MODEL=
# StepFun TTS (StepAudio / stepaudio-2.5-tts)
# The /step_plan/ gateway is what actually serves requests: measured
# 2026-09-21, the direct /v1/ base answers 402 quota_exceeded on every
# capability while /step_plan/v1/ answers 200 with real audio. Re-measure
# before trusting either prefix -- the earlier 401 reading was taken while
# the key was revoked.
STEPFUN_API_KEY=
STEPFUN_TTS_ENDPOINT=https://api.stepfun.com/step_plan/v1/audio/speech
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng
# Fish Audio TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_TTS_ENDPOINT=https://api.fish.audio/v1/audio/speech
FISH_AUDIO_TTS_MODEL=default
FISH_AUDIO_TTS_VOICE=default
# BGM provider: stepfun_music (StepAudio 3 Music, 默认) | tianpuyue | volcengine_ai_music
BGM_PROVIDER=stepfun_music
# StepFun 开放平台 key（与上方 STEPFUN_API_KEY 相同）
BGM_API_KEY=
BGM_ENDPOINT=https://api.stepfun.com
BGM_MODEL=stepaudio-3-music-preview
# BGM_LONG_MODEL 仅 tianpuyue 使用；stepfun_music 为单模型，无需设置
BGM_LONG_MODEL=
# tianpuyue-only: auto acquires a no-account callback sink at runtime; manual uses BGM_CALLBACK_BASE_URL.
BGM_CALLBACK_MODE=auto
BGM_CALLBACK_BASE_URL=
# Used only when BGM_PROVIDER=volcengine_ai_music
BGM_ACCESS_KEY_ID=
BGM_SECRET_ACCESS_KEY=
# tianpuyue / volcengine_ai_music only（stepfun_music 不使用）
BGM_SUBMIT_ACTION=GenBGMForTime
BGM_API_VERSION=2024-08-12
BGM_GENERATION_VERSION=v5.0
BGM_TIMEOUT_SECONDS=60
# stepfun_music 输出格式：wav | flac | opus | mp3 | pcm（默认 mp3）
BGM_RESPONSE_FORMAT=mp3
# StepAudio 3 Gen（语音创作场景）：voice-cast 节点的 audio_bed 块——多角色
# 对白 + 音效/环境/BGM 由模型统一编排成一段完整音频，同步返回。逐句单角色
# 台词仍走 STEPFUN_TTS_*（快、稳、有 voice_id）；本模型按 roles 自然语言描述
# 定音色，不支持 voice/timestamp。默认值即下方取值，通常无需设置。
STEP_AUDIO_GEN_ENDPOINT=https://api.stepfun.com
STEP_AUDIO_GEN_PATH=/v1/audio/generate
STEP_AUDIO_GEN_MODEL=stepaudio-3-gen-preview
COMPOSITION_API_KEY=
COMPOSITION_ENDPOINT=
COMPOSITION_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FINAL_COMPOSITION_SUBTITLE_FONT_PATH=
FINAL_COMPOSITION_RENDER_MODE=simple_sequence
FINAL_COMPOSITION_BGM_GAIN_DB_WITH_SOURCE=-18
FINAL_COMPOSITION_BGM_GAIN_DB_WITHOUT_SOURCE=-10
FINAL_COMPOSITION_BGM_FADE_OUT_SECONDS=0.5
FFMPEG_CAPABILITY_TIMEOUT_SECONDS=10
FFMPEG_VIDEO_CODEC=
FFMPEG_ALLOWED_VIDEO_ENCODERS=libx264,libopenh264
MEDIA_DATA_DIR=data
# Temporary backend-first compatibility switch. Enable after the frontend sends
# strong Workflow ETags on every semantic mutation.
V2_REQUIRE_AUTHORING_IF_MATCH=false
